# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Database
DATABASE_URL=./data/payments.db

# LLM (code reads NVIDIA_API_KEY, then Ollama fallback; OPENAI_API_KEY is not read)
NVIDIA_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Server
PORT=3000
NODE_ENV=development

# Agent
CONFIDENCE_THRESHOLD=0.7
OWNER_EMAIL=

# Money-mutating API endpoints (see src/middleware/auth.ts)
# Set in production; unset in local dev only (mutations allowed with a warning).
ADMIN_TOKEN=
OWNER_NAME=
